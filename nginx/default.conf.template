server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Add basic auth to the preview page
  location ~ ^/preview(\.html)?$ {
    auth_basic "Preview";
    auth_basic_user_file /etc/nginx/conf.d/preview.htpasswd;
    try_files /preview.html =404;
  }

 # Strip the ".html" extension
  location / {
    try_files $uri $uri.html $uri/ =404;
  }
}
